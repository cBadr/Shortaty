# ============================================
# Shortaty (شورتاتي) — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local

# --- App ---
APP_URL=https://shortaty.com
APP_NAME="شورتاتي"
APP_NAME_EN="Shortaty"
NEXT_PUBLIC_APP_URL=https://shortaty.com
NEXT_PUBLIC_APP_NAME=Shortaty

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Vercel (for domain management via API) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Coinpayments.net (Wallet topup) ---
COINPAYMENTS_PUBLIC_KEY=
COINPAYMENTS_PRIVATE_KEY=
COINPAYMENTS_IPN_SECRET=
COINPAYMENTS_MERCHANT_ID=

# --- Security ---
# Used to encrypt user Telegram bot tokens at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Used to authenticate Vercel Cron invocations
CRON_SECRET=

# --- Optional: Rate limiting (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
